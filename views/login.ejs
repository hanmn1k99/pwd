<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng nhập - <%= config.SITE_NAME %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: var(--bs-body-bg); transition: background-color 0.3s; }
        .login-container { max-width: 400px; margin-top: 15vh; }
        ion-icon { pointer-events: none; vertical-align: text-bottom; margin-right: 4px; font-size: 1.15em; }
        .fade-out { transition: opacity 0.5s ease, transform 0.5s ease; opacity: 0; transform: translateY(-20px); }
        
        /* Chế độ Dark Mode Terminal */
        [data-bs-theme="dark"] body { background-color: #000000; color: #e0e0e0; }
        [data-bs-theme="dark"] .card { background-color: #000000; border: 1px solid #333333; box-shadow: none !important; }
        [data-bs-theme="dark"] .bg-body-tertiary { background-color: #080808 !important; border: 1px solid #333; color: #00ff00 !important; }
        
        [data-bs-theme="dark"] .text-primary { color: #00ffff !important; }
        [data-bs-theme="dark"] .btn-outline-primary { color: #00ffff; border-color: #00ffff; }
        [data-bs-theme="dark"] .btn-outline-primary:hover { background-color: #00ffff; color: #000; }
        
        [data-bs-theme="dark"] .text-secondary, [data-bs-theme="dark"] .text-muted { color: #00ffff !important; opacity: 0.7; }
    </style>
</head>
<body>
    <button id="themeToggle" class="btn btn-outline-secondary position-absolute top-0 end-0 m-3 rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width:45px; height:45px;">
        <ion-icon id="themeIcon" name="moon" class="theme-btn"></ion-icon>
    </button>

    <div class="container login-container">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-<%= config.THEME_COLOR %>">
                        <ion-icon name="shield-checkmark" style="font-size: 1.8em; display:block; margin: 0 auto 10px;"></ion-icon>
                        <%= config.SITE_NAME %>
                    </h3>
                    <p class="text-muted">Hệ thống quản lý nội bộ</p>
                </div>
                <% if (error) { %>
                    <div class="alert alert-danger py-2 auto-dismiss-alert" role="alert"><ion-icon name="warning"></ion-icon> <%= error %></div>
                <% } %>
                <form method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary"><ion-icon name="person"></ion-icon> Tài khoản</label>
                        <input type="text" name="username" class="form-control form-control-lg bg-body-tertiary" required autofocus>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary"><ion-icon name="lock-closed"></ion-icon> Mật khẩu</label>
                        <input type="password" name="password" class="form-control form-control-lg bg-body-tertiary" required>
                    </div>
                    <div class="form-check mb-4 mt-3">
                        <input class="form-check-input" type="checkbox" name="remember" id="rememberCheck">
                        <label class="form-check-label text-muted" for="rememberCheck">Ghi nhớ đăng nhập (30 ngày)</label>
                    </div>
                    <!-- Đã sửa nút thành outline theo yêu cầu -->
                    <button type="submit" class="btn btn-outline-<%= config.THEME_COLOR %> btn-lg w-100 fw-bold shadow-sm"><ion-icon name="log-in"></ion-icon> Đăng nhập</button>
                </form>
            </div>
        </div>
    </div>
    
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <script>
        // Tự động ẩn thông báo lỗi sau 3 giây
        setTimeout(() => {
            document.querySelectorAll('.auto-dismiss-alert').forEach(el => {
                el.style.transition = 'opacity 0.5s ease';
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 500);
            });
        }, 3000);

        const htmlEl = document.documentElement;
        const themeBtn = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const savedTheme = localStorage.getItem('theme') || 'light';
        htmlEl.setAttribute('data-bs-theme', savedTheme);
        themeIcon.setAttribute('name', savedTheme === 'dark' ? 'sunny' : 'moon');
        if(savedTheme === 'dark') themeIcon.style.color = '#ffc107';

        themeBtn.addEventListener('click', () => {
            const current = htmlEl.getAttribute('data-bs-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            htmlEl.setAttribute('data-bs-theme', next);
            localStorage.setItem('theme', next);
            themeIcon.setAttribute('name', next === 'dark' ? 'sunny' : 'moon');
            themeIcon.style.color = next === 'dark' ? '#ffc107' : '';
        });
    </script>
</body>
</html>
