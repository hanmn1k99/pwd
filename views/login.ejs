<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng nhập - <%= config.SITE_NAME %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { background-color: var(--bs-body-bg); transition: background-color 0.3s; }
        .login-container { max-width: 400px; margin-top: 15vh; }
    </style>
</head>
<body>
    <!-- Nút Dark/Light Mode -->
    <button id="themeToggle" class="btn btn-outline-secondary position-absolute top-0 end-0 m-3 rounded-circle shadow-sm">
        <i id="themeIcon" class="bi bi-moon-fill"></i>
    </button>

    <div class="container login-container">
        <div class="card shadow border-0 rounded-3">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-<%= config.THEME_COLOR %>"><%= config.SITE_NAME %></h3>
                    <p class="text-muted">Đăng nhập hệ thống nội bộ</p>
                </div>
                <% if (error) { %>
                    <div class="alert alert-danger" role="alert"><%= error %></div>
                <% } %>
                <form method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tài khoản</label>
                        <input type="text" name="username" class="form-control form-control-lg" required autofocus>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu</label>
                        <input type="password" name="password" class="form-control form-control-lg" required>
                    </div>
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" name="remember" id="rememberCheck">
                        <label class="form-check-label text-muted" for="rememberCheck">Ghi nhớ đăng nhập (30 ngày)</label>
                    </div>
                    <button type="submit" class="btn btn-<%= config.THEME_COLOR %> btn-lg w-100 fw-bold">Đăng nhập</button>
                </form>
            </div>
        </div>
    </div>
    
    <script>
        const htmlEl = document.documentElement;
        const themeBtn = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const savedTheme = localStorage.getItem('theme') || 'light';
        htmlEl.setAttribute('data-bs-theme', savedTheme);
        themeIcon.className = savedTheme === 'dark' ? 'bi bi-sun-fill text-warning' : 'bi bi-moon-fill';

        themeBtn.addEventListener('click', () => {
            const current = htmlEl.getAttribute('data-bs-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            htmlEl.setAttribute('data-bs-theme', next);
            localStorage.setItem('theme', next);
            themeIcon.className = next === 'dark' ? 'bi bi-sun-fill text-warning' : 'bi bi-moon-fill';
        });
    </script>
</body>
</html>
