<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Dashboard - <%= config.SITE_NAME %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: var(--bs-body-bg); transition: background-color 0.3s; }
        .password-text { font-family: monospace; font-size: 1.15em; background: var(--bs-tertiary-bg); padding: 4px 10px; border-radius: 4px; letter-spacing: 1px; }
        .card { transition: all 0.2s ease-in-out; border: 1px solid var(--bs-border-color-translucent); }
        .card:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
        ion-icon { pointer-events: none; vertical-align: text-bottom; margin-right: 4px; font-size: 1.15em; }
        .btn ion-icon { margin-right: 2px; }
        .icon-only { margin-right: 0 !important; }
        
        /* Hiệu ứng mờ dần cho thông báo */
        .fade-out { transition: opacity 0.5s ease, transform 0.5s ease; opacity: 0; transform: translateY(-20px); }
    </style>
</head>
<body>

<!-- Thông báo dạng nổi ở góc trên bên phải (Toasts style) -->
<div class="position-fixed top-0 end-0 p-3" style="z-index: 1050">
    <% if (msg === 'added') { %> <div class="alert alert-success shadow-sm auto-dismiss-alert"><ion-icon name="checkmark-circle"></ion-icon> Đã lưu tài khoản thành công!</div> <% } %>
    <% if (msg === 'updated') { %> <div class="alert alert-success shadow-sm auto-dismiss-alert"><ion-icon name="checkmark-circle"></ion-icon> Đã cập nhật tài khoản!</div> <% } %>
    <% if (msg === 'useradded') { %> <div class="alert alert-success shadow-sm auto-dismiss-alert"><ion-icon name="person-add"></ion-icon> Đã tạo người dùng mới!</div> <% } %>
    <% if (msg === 'userexists') { %> <div class="alert alert-danger shadow-sm auto-dismiss-alert"><ion-icon name="warning"></ion-icon> Tên người dùng đã tồn tại!</div> <% } %>
    <% if (msg === 'pwchanged') { %> <div class="alert alert-success shadow-sm auto-dismiss-alert"><ion-icon name="checkmark-circle"></ion-icon> Đổi mật khẩu đăng nhập thành công!</div> <% } %>
    <% if (msg === 'pwchange_err') { %> <div class="alert alert-danger shadow-sm auto-dismiss-alert"><ion-icon name="close-circle"></ion-icon> Mật khẩu cũ không chính xác!</div> <% } %>
    <% if (msg === 'deleted') { %> <div class="alert alert-warning shadow-sm auto-dismiss-alert"><ion-icon name="trash"></ion-icon> Đã xóa tài khoản!</div> <% } %>
    <% if (msg === 'user_deleted') { %> <div class="alert alert-warning shadow-sm auto-dismiss-alert"><ion-icon name="trash"></ion-icon> Đã xóa người dùng!</div> <% } %>
    <% if (msg === 'cant_delete_self') { %> <div class="alert alert-danger shadow-sm auto-dismiss-alert"><ion-icon name="warning"></ion-icon> Bạn không thể tự xóa chính mình!</div> <% } %>
</div>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow">
    <div class="container">
        <a class="navbar-brand fw-bold d-flex align-items-center" href="#">
            <ion-icon name="shield-checkmark" class="text-<%= config.THEME_COLOR %> me-2" style="font-size: 1.4em;"></ion-icon> 
            <%= config.SITE_NAME %>
        </a>
        <div class="d-flex align-items-center">
            <button id="themeToggle" class="btn btn-outline-light btn-sm me-3 border-0 rounded-circle" title="Chuyển chế độ Sáng/Tối">
                <ion-icon id="themeIcon" name="moon" class="icon-only"></ion-icon>
            </button>
            <span class="text-light me-3 d-none d-md-inline">
                Xin chào, <strong><%= user.username %></strong> 
                <% if (user.is_admin) { %><span class="badge bg-danger ms-1">Admin</span><% } %>
            </span>
            <!-- Nút đổi mk outline -->
            <button class="btn btn-outline-info btn-sm me-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#changePwModal">
                <ion-icon name="key"></ion-icon> Đổi Mật Khẩu
            </button>
            <a href="/logout" class="btn btn-outline-light btn-sm fw-semibold">
                <ion-icon name="log-out"></ion-icon> Thoát
            </a>
        </div>
    </div>
</nav>

<div class="container">
    <!-- Header & Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h4 class="mb-0 text-secondary fw-bold d-flex align-items-center"><ion-icon name="folder-open" class="me-2"></ion-icon> Kho Tài Khoản</h4>
        <% if (user.is_admin) { %>
        <div>
            <!-- Các nút outline -->
            <button class="btn btn-outline-primary shadow-sm fw-bold border-2" data-bs-toggle="modal" data-bs-target="#addPasswordModal">
                <ion-icon name="add-circle"></ion-icon> Thêm Tài Khoản
            </button>
            <button class="btn btn-outline-success shadow-sm ms-2 fw-bold border-2" data-bs-toggle="modal" data-bs-target="#addUserModal">
                <ion-icon name="people"></ion-icon> Quản lý User
            </button>
        </div>
        <% } %>
    </div>

    <!-- Passwords Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mb-5">
        <% if (passwords.length > 0) { %>
            <% passwords.forEach(p => { %>
            <div class="col">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title text-<%= config.THEME_COLOR %> fw-bold mb-0"><%= p.title %></h5>
                            <div>
                                <% if (p.url) { %>
                                    <% let fixedUrl = p.url; if (!fixedUrl.startsWith('http://') && !fixedUrl.startsWith('https://')) fixedUrl = 'https://' + fixedUrl; %>
                                    <a href="<%= fixedUrl %>" target="_blank" class="btn btn-sm btn-outline-secondary border-0" title="Mở đường dẫn"><ion-icon name="open" class="icon-only"></ion-icon></a>
                                <% } %>
                                <% if (user.is_admin) { %>
                                    <button class="btn btn-sm btn-outline-primary border-0" data-bs-toggle="modal" data-bs-target="#editPasswordModal-<%= p.id %>" title="Sửa"><ion-icon name="create" class="icon-only"></ion-icon></button>
                                    <form action="/delete_password/<%= p.id %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa dữ liệu này không?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Xóa"><ion-icon name="trash" class="icon-only"></ion-icon></button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                        <div class="mb-3 bg-body-tertiary p-2 rounded">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.70em; letter-spacing: 1px;"><ion-icon name="person"></ion-icon> Tài khoản</small>
                            <strong class="text-body fs-6"><%= p.acc_username %></strong>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block text-uppercase fw-bold mb-1" style="font-size: 0.70em; letter-spacing: 1px;"><ion-icon name="lock-closed"></ion-icon> Mật khẩu</small>
                            <div class="input-group">
                                <span class="input-group-text password-text border-end-0 flex-grow-1" id="pw-<%= p.id %>">••••••••</span>
                                <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePassword('<%= p.id %>', '<%= p.decrypted.replace(/'/g, "\\'") %>')">
                                    <ion-icon name="eye" class="icon-only" id="icon-<%= p.id %>"></ion-icon>
                                </button>
                            </div>
                        </div>
                        <% if (p.notes) { %>
                        <div class="mt-3 border-top pt-2">
                            <small class="text-muted d-block text-uppercase fw-bold mb-1" style="font-size: 0.70em; letter-spacing: 1px;"><ion-icon name="document-text"></ion-icon> Ghi chú</small>
                            <span class="text-secondary" style="font-size: 0.9em;"><%= p.notes %></span>
                        </div>
                        <% } %>
                    </div>
                    <% if (user.is_admin && p.shared_with) { %>
                    <div class="card-footer bg-body-tertiary border-top pt-3 pb-3 rounded-bottom-4">
                        <small class="text-muted d-block mb-2 fw-semibold" style="font-size: 0.8em;"><ion-icon name="share-social"></ion-icon> Đã chia sẻ với:</small>
                        <div class="d-flex flex-wrap gap-1">
                        <% p.shared_with.forEach(u => { %> <span class="badge bg-secondary fw-normal"><%= u %></span> <% }) %>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
            <% }) %>
        <% } else { %>
            <div class="col-12">
                <div class="text-center p-5 bg-body rounded-4 shadow-sm text-muted border">
                    <ion-icon name="cube" style="font-size: 4em; color: #ccc;"></ion-icon>
                    <p class="mt-3 fs-5">Kho dữ liệu trống.</p>
                </div>
            </div>
        <% } %>
    </div>
</div>

<!-- Change Password Modal (For all users) -->
<div class="modal fade" id="changePwModal" tabindex="-1">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">
      <div class="modal-header border-bottom-0 pb-0">
        <h6 class="modal-title fw-bold text-info"><ion-icon name="key"></ion-icon> Đổi Mật Khẩu Đăng Nhập</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/change_my_password" method="POST">
          <div class="modal-body">
              <div class="mb-3">
                  <input type="password" name="old_password" class="form-control bg-body-tertiary" placeholder="Mật khẩu hiện tại" required>
              </div>
              <div class="mb-1">
                  <input type="password" name="new_password" class="form-control bg-body-tertiary" placeholder="Mật khẩu mới" required>
              </div>
          </div>
          <div class="modal-footer border-top-0 pt-0">
            <!-- Nút outline -->
            <button type="submit" class="btn btn-outline-info border-2 w-100 fw-bold shadow-sm">Xác nhận đổi</button>
          </div>
      </form>
    </div>
  </div>
</div>

<% if (user.is_admin) { %>
<!-- Add Password Modal -->
<div class="modal fade" id="addPasswordModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">
      <div class="modal-header border-bottom-0">
        <h5 class="modal-title fw-bold text-<%= config.THEME_COLOR %>"><ion-icon name="add-circle"></ion-icon> Thêm Tài Khoản Lưu Trữ</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/add_password" method="POST">
          <div class="modal-body py-0">
              <div class="mb-3">
                  <label class="form-label fw-semibold text-secondary">Tên hệ thống</label>
                  <input type="text" name="title" class="form-control bg-body-tertiary" placeholder="VD: Facebook Công ty, Gmail..." required>
              </div>
              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label class="form-label fw-semibold text-secondary">Tài khoản</label>
                      <input type="text" name="acc_username" class="form-control bg-body-tertiary">
                  </div>
                  <div class="col-md-6 mb-3">
                      <label class="form-label fw-semibold text-secondary">Mật khẩu</label>
                      <input type="text" name="password" class="form-control bg-body-tertiary" required>
                  </div>
              </div>
              <div class="mb-3">
                  <label class="form-label fw-semibold text-secondary">Đường dẫn (URL)</label>
                  <input type="text" name="url" class="form-control bg-body-tertiary" placeholder="abc.xyz hoặc https://abc.xyz">
              </div>
              <div class="mb-3">
                  <label class="form-label fw-semibold text-secondary">Ghi chú</label>
                  <textarea name="notes" class="form-control bg-body-tertiary" rows="2" placeholder="Thông tin thêm..."></textarea>
              </div>
              <div class="mb-3">
                  <label class="form-label fw-semibold text-secondary">Phân quyền cho User <small class="text-muted fw-normal">(Giữ Ctrl để chọn)</small></label>
                  <select name="allowed_users" class="form-select bg-body-tertiary" multiple size="3">
                      <% allUsers.forEach(u => { %>
                          <% if (u.id !== user.id) { %>
                          <option value="<%= u.id %>"><%= u.username %></option>
                          <% } %>
                      <% }) %>
                  </select>
              </div>
          </div>
          <div class="modal-footer border-top-0 pt-3 mt-2">
            <button type="button" class="btn btn-outline-secondary fw-semibold border-2" data-bs-dismiss="modal">Hủy</button>
            <button type="submit" class="btn btn-outline-<%= config.THEME_COLOR %> px-4 fw-bold shadow-sm border-2"><ion-icon name="save"></ion-icon> Lưu ngay</button>
          </div>
      </form>
    </div>
  </div>
</div>

<% passwords.forEach(p => { %>
<!-- Edit Password Modal for <%= p.id %> -->
<div class="modal fade" id="editPasswordModal-<%= p.id %>" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">
      <div class="modal-header border-bottom-0">
        <h5 class="modal-title fw-bold text-primary"><ion-icon name="create"></ion-icon> Sửa Tài Khoản</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/edit_password/<%= p.id %>" method="POST">
          <div class="modal-body py-0">
              <div class="mb-3">
                  <label class="form-label fw-semibold text-secondary">Tên hệ thống</label>
                  <input type="text" name="title" class="form-control bg-body-tertiary" value="<%= p.title %>" required>
              </div>
              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label class="form-label fw-semibold text-secondary">Tài khoản</label>
                      <input type="text" name="acc_username" class="form-control bg-body-tertiary" value="<%= p.acc_username %>">
                  </div>
                  <div class="col-md-6 mb-3">
                      <label class="form-label fw-semibold text-secondary">Mật khẩu mới</label>
                      <input type="text" name="password" class="form-control bg-body-tertiary" placeholder="Bỏ trống = Không đổi">
                  </div>
              </div>
              <div class="mb-3">
                  <label class="form-label fw-semibold text-secondary">Đường dẫn (URL)</label>
                  <input type="text" name="url" class="form-control bg-body-tertiary" value="<%= p.url || '' %>">
              </div>
              <div class="mb-3">
                  <label class="form-label fw-semibold text-secondary">Ghi chú</label>
                  <textarea name="notes" class="form-control bg-body-tertiary" rows="2"><%= p.notes || '' %></textarea>
              </div>
              <div class="mb-3">
                  <label class="form-label fw-semibold text-secondary">Phân quyền cho User</label>
                  <select name="allowed_users" class="form-select bg-body-tertiary" multiple size="3">
                      <% allUsers.forEach(u => { %>
                          <% if (u.id !== user.id) { %>
                          <option value="<%= u.id %>" <%= (p.shared_with && p.shared_with.includes(u.username)) ? 'selected' : '' %>><%= u.username %></option>
                          <% } %>
                      <% }) %>
                  </select>
              </div>
          </div>
          <div class="modal-footer border-top-0 pt-3 mt-2">
            <button type="button" class="btn btn-outline-secondary fw-semibold border-2" data-bs-dismiss="modal">Hủy</button>
            <button type="submit" class="btn btn-outline-primary px-4 fw-bold shadow-sm border-2"><ion-icon name="save"></ion-icon> Cập nhật</button>
          </div>
      </form>
    </div>
  </div>
</div>
<% }) %>

<!-- Manage Users Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-success"><ion-icon name="people"></ion-icon> Quản lý Người Dùng</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
          <div class="bg-body-tertiary p-3 rounded-4 mb-4 border shadow-sm">
              <h6 class="fw-bold mb-3"><ion-icon name="person-add"></ion-icon> Tạo tài khoản mới</h6>
              <form action="/add_user" method="POST">
                  <div class="row g-2 mb-2">
                      <div class="col-sm-6">
                          <input type="text" name="username" class="form-control form-control-sm" placeholder="Tên đăng nhập" required>
                      </div>
                      <div class="col-sm-6">
                          <input type="text" name="password" class="form-control form-control-sm" placeholder="Mật khẩu" required>
                      </div>
                  </div>
                  <div class="d-flex justify-content-between align-items-center mt-3">
                      <div class="form-check">
                          <input type="checkbox" name="is_admin" class="form-check-input border-secondary" id="checkAdmin">
                          <label class="form-check-label text-danger fw-semibold" style="font-size: 0.9em;" for="checkAdmin">Cấp quyền Admin</label>
                      </div>
                      <button type="submit" class="btn btn-outline-success btn-sm fw-bold px-3 border-2"><ion-icon name="add"></ion-icon> Tạo</button>
                  </div>
              </form>
          </div>
          
          <h6 class="fw-bold mb-3"><ion-icon name="list"></ion-icon> Danh sách tài khoản</h6>
          <ul class="list-group list-group-flush border rounded-4 overflow-hidden mb-2 shadow-sm">
            <% allUsers.forEach(u => { %>
                <li class="list-group-item bg-body d-flex justify-content-between align-items-center py-2">
                    <div>
                        <ion-icon name="person-circle" class="text-secondary me-2 fs-5"></ion-icon> <strong style="vertical-align: super;"><%= u.username %></strong>
                    </div>
                    <div>
                        <% if (u.is_admin) { %><span class="badge bg-danger rounded-pill me-2">Admin</span><% } else { %><span class="badge bg-secondary rounded-pill me-2">User</span><% } %>
                        <% if (u.id !== user.id) { %>
                            <form action="/delete_user/<%= u.id %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa user <%= u.username %> không?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0 p-1" title="Xóa User"><ion-icon name="trash" class="icon-only fs-6"></ion-icon></button>
                            </form>
                        <% } %>
                    </div>
                </li>
            <% }) %>
          </ul>
      </div>
    </div>
  </div>
</div>
<% } %>

<script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Ẩn thông báo sau 3 giây
    setTimeout(() => {
        document.querySelectorAll('.auto-dismiss-alert').forEach(el => {
            el.classList.add('fade-out');
            setTimeout(() => el.remove(), 500); // Đợi CSS transition xong thì xóa DOM
        });
    }, 3000);

    function togglePassword(id, password) {
        let el = document.getElementById('pw-' + id);
        let btnIcon = document.getElementById('icon-' + id);
        
        if (el.innerText === '••••••••') {
            el.innerText = password;
            btnIcon.setAttribute('name', 'eye-off');
        } else {
            el.innerText = '••••••••';
            btnIcon.setAttribute('name', 'eye');
        }
    }

    const htmlEl = document.documentElement;
    const themeBtn = document.getElementById('themeToggle');
    const themeIcon = document.getElementById('themeIcon');
    const savedTheme = localStorage.getItem('theme') || 'light';
    
    htmlEl.setAttribute('data-bs-theme', savedTheme);
    themeIcon.setAttribute('name', savedTheme === 'dark' ? 'sunny' : 'moon');
    if(savedTheme === 'dark') themeIcon.style.color = '#ffc107';

    themeBtn.addEventListener('click', () => {
        const current = htmlEl.getAttribute('data-bs-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        htmlEl.setAttribute('data-bs-theme', next);
        localStorage.setItem('theme', next);
        themeIcon.setAttribute('name', next === 'dark' ? 'sunny' : 'moon');
        themeIcon.style.color = next === 'dark' ? '#ffc107' : '';
    });
</script>
</body>
</html>
