<% } %>

<!-- Modal Upload Excel -->
<div class="modal fade" id="uploadCsvModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-<%= config.THEME_COLOR %>"><ion-icon name="cloud-upload"></ion-icon> Nhập dữ liệu hàng loạt</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
          <div class="alert alert-info py-2" style="font-size: 0.85em;">
              <ion-icon name="information-circle"></ion-icon> <strong>Lưu ý:</strong> Tính năng này chỉ dùng để chia sẻ hàng loạt. <strong>Cột SecretCode là bắt buộc</strong>, các dòng để trống sẽ bị bỏ qua.
          </div>
          <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="text-secondary small">Vui lòng sử dụng file mẫu chuẩn:</span>
              <a href="/download_template" class="btn btn-sm btn-outline-success"><ion-icon name="download"></ion-icon> Tải File Mẫu (.xlsx)</a>
          </div>
          <div class="mb-3">
              <input class="form-control" type="file" id="excelFileInput" accept=".xlsx, .xls">
          </div>
          <div id="uploadProgress" class="d-none">
              <div class="progress mb-2" style="height: 10px;">
                  <div class="progress-bar progress-bar-striped progress-bar-animated bg-<%= config.THEME_COLOR %>" id="uploadProgressBar" style="width: 0%"></div>
              </div>
              <p class="text-center text-muted small mb-0" id="uploadStatusText">Đang xử lý...</p>
          </div>
      </div>
      <div class="modal-footer border-top-0 pt-0">
          <button type="button" class="btn btn-warning w-100 fw-bold" onclick="processExcel()"><ion-icon name="play"></ion-icon> Bắt Đầu Nhập</button>
      </div>
    </div>
  </div>
</div>

<script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js?v=<%= Date.now() %>"></script>

    <!-- Đăng ký Service Worker cho PWA -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js');
        });
      }
    </script>
    <script>
        function addLinkRow(id) {
            const container = document.getElementById('link-container-' + id);
            const html = `
                <div class="input-group mb-2 link-row">
                    <input type="text" class="form-control link-name" placeholder="Tên">
                    <input type="text" class="form-control link-url" placeholder="Link">
                    <button class="btn btn-outline-danger btn-remove-link" type="button" onclick="this.parentElement.remove()"><ion-icon name="trash" class="d-flex"></ion-icon></button>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', html);
        }

        function compileUrl(id) {
            const container = document.getElementById('link-container-' + id);
            const protocol = document.querySelector(`input[name="protocol_${id}"]:checked`).value;
            const rows = container.querySelectorAll('.link-row');
            let compiled = [];
            
            rows.forEach(row => {
                let name = row.querySelector('.link-name').value.trim();
                let url = row.querySelector('.link-url').value.trim();
                
                if (url !== '') {
                    // Nếu người dùng đã tự gõ http/https thì tôn trọng, không thì tự gắn
                    let fullUrl = (url.startsWith('http://') || url.startsWith('https://')) ? url : protocol + url;
                    
                    if (name !== '') {
                        compiled.push(`${name} | ${fullUrl}`);
                    } else {
                        compiled.push(`${fullUrl}`);
                    }
                }
            });
            
            document.getElementById('final_url_' + id).value = compiled.join(', ');
        }

        function processExcel() {
            const fileInput = document.getElementById('excelFileInput');
            if (!fileInput.files.length) {
                alert('Vui lòng chọn một file Excel (.xlsx)!');
                return;
            }
            
            const progress = document.getElementById('uploadProgress');
            const bar = document.getElementById('uploadProgressBar');
            const status = document.getElementById('uploadStatusText');
            
            progress.classList.remove('d-none');
            bar.style.width = '30%';
            status.innerText = 'Đang đẩy file lên Server...';
            
            const formData = new FormData();
            formData.append('excelFile', fileInput.files[0]);
            
            fetch('/bulk_upload_excel', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                bar.style.width = '100%';
                bar.classList.replace('bg-<%= config.THEME_COLOR %>', 'bg-success');
                if (data.success) {
                    status.innerText = `Thành công: Đã nhập ${data.count} tài khoản! Tải lại trang...`;
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    status.innerText = `Lỗi: ${data.error}`;
                    bar.classList.replace('bg-success', 'bg-danger');
                }
            })
            .catch(err => {
                status.innerText = 'Lỗi kết nối!';
                bar.classList.replace('bg-<%= config.THEME_COLOR %>', 'bg-danger');
            });
        }
    
    </script>
</body>
</html>
