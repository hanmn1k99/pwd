<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Dashboard - <%= config.SITE_NAME %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css?v=1788340493607">

    <!-- PWA & Favicon -->
    <link rel="icon" type="image/png" href="/icon.png">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0d6efd">
</head>
<body>

<!-- Thông báo dạng nổi ở góc trên bên phải -->
<div class="position-fixed top-0 end-0 p-3" style="z-index: 1050">
    <% if (msg === 'added') { %> <div class="alert alert-success shadow-sm auto-dismiss-alert"><ion-icon name="checkmark-circle"></ion-icon> Đã lưu tài khoản thành công!</div> <% } %>
    <% if (msg === 'updated') { %> <div class="alert alert-success shadow-sm auto-dismiss-alert"><ion-icon name="checkmark-circle"></ion-icon> Đã cập nhật tài khoản!</div> <% } %>
    <% if (msg === 'useradded') { %> <div class="alert alert-success shadow-sm auto-dismiss-alert"><ion-icon name="person-add"></ion-icon> Đã tạo người dùng mới!</div> <% } %>
    <% if (msg === 'userexists') { %> <div class="alert alert-danger shadow-sm auto-dismiss-alert"><ion-icon name="warning"></ion-icon> Tên người dùng đã tồn tại!</div> <% } %>
    <% if (msg === 'pwchanged') { %> <div class="alert alert-success shadow-sm auto-dismiss-alert"><ion-icon name="checkmark-circle"></ion-icon> Đổi mật khẩu đăng nhập thành công!</div> <% } %>
    <% if (msg === 'pwchange_err') { %> <div class="alert alert-danger shadow-sm auto-dismiss-alert"><ion-icon name="close-circle"></ion-icon> Mật khẩu cũ không chính xác!</div> <% } %>
    <% if (msg === 'deleted') { %> <div class="alert alert-warning shadow-sm auto-dismiss-alert"><ion-icon name="trash"></ion-icon> Đã xóa tài khoản!</div> <% } %>
    <% if (msg === 'user_deleted') { %> <div class="alert alert-warning shadow-sm auto-dismiss-alert"><ion-icon name="trash"></ion-icon> Đã xóa người dùng!</div> <% } %>
    <% if (msg === 'cant_delete_self') { %> <div class="alert alert-danger shadow-sm auto-dismiss-alert"><ion-icon name="warning"></ion-icon> Bạn không thể tự xóa chính mình!</div> <% } %>
</div>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow">
    <div class="container">
        <a class="navbar-brand fw-bold d-flex align-items-center" href="https://minhhan.net" target="_blank">
            <img src="/logo.png" alt="Logo" style="width: 180px; height: auto;">
        </a>
        <div class="d-flex align-items-center">
            <button id="themeToggle" class="btn btn-outline-light btn-sm me-3 border-0 rounded-circle" title="Chuyển chế độ Sáng/Tối">
                <ion-icon id="themeIcon" name="moon" class="icon-only"></ion-icon>
            </button>
            <span class="text-light me-3 d-none d-md-inline">
                Xin chào, <strong><!--email_off--><%= user.username %><!--/email_off--></strong> 
                <% if (user.is_admin) { %><span class="badge bg-danger ms-1">Admin</span><% } %>
            </span>
            
            <button class="btn btn-outline-info btn-sm me-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#changePwModal">
                <ion-icon name="key"></ion-icon> Đổi Mật Khẩu
            </button>
            <a href="/logout" class="btn btn-outline-light btn-sm fw-semibold">
                <ion-icon name="log-out"></ion-icon> Thoát
            </a>
        </div>
    </div>
</nav>

<div class="container">
    <!-- Header & Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h4 class="mb-0 text-secondary fw-bold d-flex align-items-center"><ion-icon name="folder-open" class="me-2"></ion-icon> Kho Tài Khoản</h4>
        <% if (user.is_admin) { %>
        <div>
            
            <button class="btn btn-outline-success shadow-sm ms-2 fw-bold border-2" data-bs-toggle="modal" data-bs-target="#addUserModal">
                <ion-icon name="people"></ion-icon> Quản lý User
            </button>
        </div>
        <% } %>
    </div>

<% 
    let internalPass = passwords.filter(p => !p.secret_code || p.secret_code.trim() === '');
    let sharedPass = passwords.filter(p => p.secret_code && p.secret_code.trim() !== '');
%>

    <!-- Nav Tabs -->
    <ul class="nav nav-pills p-1 bg-body-tertiary border border-secondary-subtle rounded-pill d-inline-flex mb-4 shadow-sm" id="passwordTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold px-4 rounded-pill" id="internal-tab" data-bs-toggle="pill" data-bs-target="#internal-tab-pane" type="button" role="tab"><ion-icon name="shield-checkmark" class="me-1"></ion-icon> Nội Bộ (<%= internalPass.length %>)</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold px-4 rounded-pill" id="shared-tab" data-bs-toggle="pill" data-bs-target="#shared-tab-pane" type="button" role="tab"><ion-icon name="share-social" class="me-1"></ion-icon> Công Khai (<%= sharedPass.length %>)</button>
      </li>
    </ul>

    <div class="tab-content" id="passwordTabsContent">
      <!-- Internal Tab -->
      <div class="tab-pane fade show active" id="internal-tab-pane" role="tabpanel">
        <!-- Passwords Grid -->
        <div class="d-flex justify-content-end mb-3">
              <% if (user.is_admin) { %>
              <button class="btn btn-outline-primary shadow-sm fw-bold border-2" data-bs-toggle="modal" data-bs-target="#addInternalModal">
                  <ion-icon name="add-circle"></ion-icon> Thêm Mới Nội Bộ
              </button>
              <% } %>
          </div>
          <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mb-5">
            <% if (internalPass.length > 0) { %>
                <% internalPass.forEach(p => { %>
                <div class="col">
                    <div class="card h-100 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title text-<%= config.THEME_COLOR %> fw-bold mb-0"><%= p.title %></h5>
                                <div>
                                    <% if (user.is_admin) { %>
                                        <button class="btn btn-sm btn-outline-primary border-0" data-bs-toggle="modal" data-bs-target="#editPasswordModal-<%= p.id %>" title="Sửa"><ion-icon name="create" class="icon-only fs-5"></ion-icon></button>
                                        <form action="/delete_password/<%= p.id %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa dữ liệu này không?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Xóa"><ion-icon name="trash" class="icon-only fs-5"></ion-icon></button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                            <div class="mb-3">
                                <small class="text-muted d-block text-uppercase fw-bold mb-2" style="font-size: 0.70em; letter-spacing: 1px;"><ion-icon name="person"></ion-icon> Tài khoản</small>
                                <div class="d-flex align-items-center border border-secondary-subtle rounded-3 overflow-hidden bg-body-tertiary">
                                    <strong class="flex-grow-1 px-3 py-2 mb-0 text-body fs-6"><!--email_off--><%= p.acc_username %><!--/email_off--></strong>
                                    <button class="btn btn-link text-secondary text-decoration-none border-0 px-3 border-start border-secondary-subtle rounded-0" type="button" onclick="copyToClipboard('<%= p.acc_username.replace(/'/g, "\\'") %>')" title="Copy tài khoản">
                                        <ion-icon name="copy" class="icon-only fs-5"></ion-icon>
                                    </button>
                                </div>
                            </div>
                            <div class="mb-3">
                                <small class="text-muted d-block text-uppercase fw-bold mb-2" style="font-size: 0.70em; letter-spacing: 1px;"><ion-icon name="lock-closed"></ion-icon> Mật khẩu</small>
                                <div class="d-flex align-items-center border border-secondary-subtle rounded-3 overflow-hidden bg-body-tertiary">
                                    <span class="flex-grow-1 px-3 py-2 mb-0 font-monospace text-body" id="pw-<%= p.id %>" style="font-size: 1.15em; letter-spacing: 2px;">••••••••</span>
                                    <% if (user.is_admin) { %>
                                    <button class="btn btn-link text-secondary text-decoration-none border-0 px-3 border-start border-secondary-subtle rounded-0" type="button" onclick="togglePassword('<%= p.id %>', '<%= p.decrypted.replace(/'/g, "\\'") %>')" title="Xem/Ẩn mật khẩu">
                                        <ion-icon name="eye" class="icon-only fs-5" id="icon-<%= p.id %>"></ion-icon>
                                    </button>
                                    <% } %>
                                    <button class="btn btn-link text-secondary text-decoration-none border-0 px-3 border-start border-secondary-subtle rounded-0" type="button" onclick="copyToClipboard('<%= p.decrypted.replace(/'/g, "\\'") %>')" title="Copy mật khẩu">
                                        <ion-icon name="copy" class="icon-only fs-5"></ion-icon>
                                    </button>
                                </div>
                            </div>
                            <% if (p.url) { %>
                            <div class="mb-3 d-flex flex-wrap gap-1">
                                <% 
                                  let items = p.url.split(/[,;\n]+/).filter(u => u.trim() !== '');
                                  items.forEach(item => {
                                    let name = '';
                                    let rawUrl = '';
                                    if (item.includes('|')) {
                                        let parts = item.split('|');
                                        let p0 = parts[0].trim();
                                        let p1 = parts.slice(1).join('|').trim();
                                        let p0IsUrl = /^https?:\/\//i.test(p0) || (p0.includes('.') && !p0.includes(' '));
                                        let p1IsUrl = /^https?:\/\//i.test(p1) || (p1.includes('.') && !p1.includes(' '));
                                        if (p0IsUrl && !p1IsUrl) { rawUrl = p0; name = p1; } else { rawUrl = p1; name = p0; }
                                    } else {
                                        rawUrl = item.trim();
                                        name = rawUrl.replace(/^https?:\/\//i, '');
                                    }
                                    let fixedUrl = rawUrl;
                                    if (!fixedUrl.startsWith('http://') && !fixedUrl.startsWith('https://')) { fixedUrl = 'http://' + fixedUrl; }
                                %>
                                <a href="<%= fixedUrl %>" target="_blank" class="badge bg-body-secondary text-secondary text-decoration-none d-inline-flex align-items-center py-1 px-2 border border-secondary-subtle fw-medium rounded-pill" style="font-size: 0.75em;">
                                    <ion-icon name="link-outline" class="me-1"></ion-icon> <%= name %>
                                </a>
                                <% }); %>
                            </div>
                            <% } %>
                            <% if (p.notes) { %>
                            <div class="mt-3 border-top pt-2">
                                <small class="text-muted d-block text-uppercase fw-bold mb-1" style="font-size: 0.70em; letter-spacing: 1px;"><ion-icon name="document-text"></ion-icon> Ghi chú</small>
                                <span class="text-secondary" style="font-size: 0.9em;"><%= p.notes %></span>
                            </div>
                            <% } %>
                        </div>
                        <% if (user.is_admin) { %>
                        <div class="card-footer bg-body-tertiary border-top px-4 pt-3 pb-3 rounded-bottom-4 mt-auto">
                            <div class="d-flex align-items-center flex-wrap gap-2">
                                <span class="text-muted fw-semibold mb-0 d-flex align-items-center" style="font-size: 0.85em;"><ion-icon name="people" class="me-1 fs-6"></ion-icon> Quyền truy cập:</span>
                                <% 
                                    let display_shared = p.shared_with ? p.shared_with.filter(name => name !== user.username) : [];
                                %>
                                <% if (display_shared.length > 0) { %>
                                    <% display_shared.forEach(u => { %> <span class="badge badge-user rounded-pill fw-normal d-inline-flex align-items-center px-2 py-1"><ion-icon name="person-circle" class="me-1 fs-6"></ion-icon><!--email_off--><%= u %><!--/email_off--></span> <% }) %>
                                <% } else { %>
                                    <span class="badge badge-private rounded-pill fw-normal d-inline-flex align-items-center px-2 py-1"><ion-icon name="lock-closed" class="me-1"></ion-icon>Riêng tư</span>
                                <% } %>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
                <% }) %>
            <% } else { %>
                <div class="col-12">
                    <div class="text-center p-5 bg-body rounded-4 shadow-sm text-muted border">
                        <ion-icon name="cube" style="font-size: 4em; color: #ccc;"></ion-icon>
                        <p class="mt-3 fs-5">Kho dữ liệu trống.</p>
                    </div>
                </div>
            <% } %>
        </div> <!-- End row -->
      </div> <!-- End internal-tab-pane -->

      <!-- Shared Tab -->
      <div class="tab-pane fade" id="shared-tab-pane" role="tabpanel">
        <% if (user.is_admin) { %>
        <div class="d-flex justify-content-end mb-3">
            <button class="btn btn-outline-success btn-sm fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#uploadCsvModal">
                <ion-icon name="cloud-upload"></ion-icon> Nhập File Excel (Hàng Loạt)
            </button>
        </div>
        <% } %>
        <% if (sharedPass.length > 0) { %>
        <div class="table-responsive bg-body-tertiary rounded-4 border border-secondary-subtle shadow-sm mb-5">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 20%;">Mã Chia Sẻ</th>
                        <th style="width: 25%;">Tiêu đề</th>
                        <th style="width: 20%;">Tài khoản</th>
                        <th style="width: 15%;">Mật khẩu</th>
                        <th class="text-end pe-4" style="width: 20%;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <% sharedPass.forEach(p => { %>
                    <tr>
                        <td class="ps-4">
                            <div class="d-inline-flex align-items-center">
                                <span class="font-monospace text-body" id="secret-<%= p.id %>" style="font-size: 1.1em; letter-spacing: 2px; min-width: 90px; text-align: center; display: inline-block;">••••••••</span>
                                <button class="btn btn-sm btn-link text-secondary p-0 ms-2" onclick="toggleSecret('<%= p.id %>', '<%= p.secret_code.replace(/'/g, "\\\\'") %>')" title="Xem/Ẩn Mã Bí Mật">
                                    <ion-icon name="eye" id="icon-secret-<%= p.id %>" class="fs-6"></ion-icon>
                                </button>
                            </div>
                        </td>
                        <td class="fw-bold text-<%= config.THEME_COLOR %>"><%= p.title %></td>
                        <td><!--email_off--><%= p.acc_username %><!--/email_off--></td>
                        <td>
                            <span class="font-monospace text-body" id="pw-shared-<%= p.id %>" style="letter-spacing: 2px; min-width: 90px; display: inline-block;">••••••••</span>
                        </td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-outline-secondary border-0" onclick="copyToClipboard('<%= p.secret_code %>')" title="Copy Mã Bí Mật"><ion-icon name="key" class="icon-only fs-6"></ion-icon></button>
                            <button class="btn btn-sm btn-outline-secondary border-0" onclick="togglePasswordShared('<%= p.id %>', '<%= p.decrypted.replace(/'/g, "\\'") %>')" title="Xem mật khẩu"><ion-icon name="eye" id="icon-shared-<%= p.id %>" class="icon-only fs-6"></ion-icon></button>
                            <% if (user.is_admin) { %>
                            <button class="btn btn-sm btn-outline-primary border-0 ms-1" data-bs-toggle="modal" data-bs-target="#editPasswordModal-<%= p.id %>" title="Sửa"><ion-icon name="create" class="icon-only fs-6"></ion-icon></button>
                            <form action="/delete_password/<%= p.id %>" method="POST" class="d-inline" onsubmit="return confirm('Xóa mật khẩu này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Xóa"><ion-icon name="trash" class="icon-only fs-6"></ion-icon></button>
                            </form>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% } else { %>
            <div class="col-12">
                <div class="text-center p-5 bg-body rounded-4 shadow-sm text-muted border mb-5">
                    <ion-icon name="share-social" style="font-size: 4em; color: #ccc;"></ion-icon>
                    <p class="mt-3 fs-5">Chưa có mật khẩu nào được chia sẻ.</p>
                </div>
            </div>
        <% } %>
      </div> <!-- End shared-tab-pane -->
    </div> <!-- End tab-content -->

<% if (user.is_admin) { %>
<!-- Add Internal Modal -->
<div class="modal fade" id="addInternalModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">
      <div class="modal-header border-bottom-0">
        <h5 class="modal-title fw-bold text-<%= config.THEME_COLOR %>"><ion-icon name="shield-checkmark"></ion-icon> Thêm Tài Khoản Nội Bộ</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/add_password" method="POST" autocomplete="off" onsubmit="compileUrl('new_int')">
          <div class="modal-body py-0">
              <input type="hidden" name="is_public_new" value="0">
              <div class="mb-3">
                  <label class="form-label fw-semibold text-secondary">Tên hệ thống</label>
                  <input type="text" name="title" class="form-control" placeholder="VD: Facebook Công ty, Gmail..." required>
              </div>
              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label class="form-label fw-semibold text-secondary">Tài khoản</label>
                      <input type="text" name="acc_username" class="form-control" autocomplete="off">
                  </div>
                  <div class="col-md-6 mb-3">
                      <label class="form-label fw-semibold text-secondary">Mật khẩu</label>
                      <input type="text" name="password" class="form-control" required autocomplete="new-password">
                  </div>
              </div>
              <div class="mb-3 url-section">
                  <label class="form-label fw-semibold text-secondary mb-1">Cấu hình Đường dẫn (URL)</label>
                  <div class="mb-3">
                      <div class="btn-group btn-group-sm w-100 shadow-sm" role="group">
                          <input type="radio" class="btn-check" name="protocol_new_int" id="proto_https_new_int" value="https://" checked>
                          <label class="btn btn-outline-success" for="proto_https_new_int"><ion-icon name="lock-closed"></ion-icon> HTTPS (Bảo mật)</label>
                          <input type="radio" class="btn-check" name="protocol_new_int" id="proto_http_new_int" value="http://">
                          <label class="btn btn-outline-info" for="proto_http_new_int"><ion-icon name="globe"></ion-icon> HTTP (Nội bộ)</label>
                      </div>
                  </div>
                  <div id="link-container-new_int">
                      <div class="input-group mb-2 link-row">
                          <input type="text" class="form-control link-name" placeholder="Tên">
                          <input type="text" class="form-control link-url" placeholder="Link">
                          <button class="btn btn-outline-danger btn-remove-link" type="button" onclick="this.parentElement.remove()"><ion-icon name="trash" class="d-flex"></ion-icon></button>
                      </div>
                  </div>
                  <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addLinkRow('new_int')"><ion-icon name="add" class="align-middle"></ion-icon> Thêm Link</button>
                  <input type="hidden" name="url" id="final_url_new_int">
              </div>
              <div class="mb-3 notes-section">
                  <label class="form-label fw-semibold text-secondary">Ghi chú</label>
                  <textarea name="notes" class="form-control" rows="2" placeholder="Thông tin thêm..."></textarea>
              </div>
              <div class="mb-3 users-section">
                  <label class="form-label fw-semibold text-secondary d-block">Phân quyền cho User</label>
                  <div class="d-flex flex-wrap gap-2 border p-2 rounded-3">
                      <% allUsers.forEach(u => { %>
                          <% if (u.id !== user.id) { %>
                          <div>
                              <input type="checkbox" class="btn-check" name="allowed_users" value="<%= u.id %>" id="addUser-<%= u.id %>">
                              <label class="btn btn-outline-secondary rounded-pill btn-sm d-inline-flex align-items-center fw-normal" for="addUser-<%= u.id %>">
                                  <ion-icon name="person-circle" class="me-1 fs-6"></ion-icon><!--email_off--><%= u.username %><!--/email_off-->
                              </label>
                          </div>
                          <% } %>
                      <% }) %>
                      <% if (allUsers.length <= 1) { %>
                          <small class="text-muted fst-italic">Chưa có user nào khác ngoài bạn.</small>
                      <% } %>
                  </div>
              </div>
          </div>
          <div class="modal-footer border-top-0 pt-3 mt-2">
            <button type="button" class="btn btn-outline-secondary fw-semibold border-2" data-bs-dismiss="modal">Hủy</button>
            <button type="submit" class="btn btn-outline-<%= config.THEME_COLOR %> px-4 fw-bold shadow-sm border-2"><ion-icon name="save"></ion-icon> Lưu ngay</button>
          </div>
      </form>
    </div>
  </div>
</div>

<!-- Add Public Modal -->
<div class="modal fade" id="addPublicModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">
      <div class="modal-header border-bottom-0">
        <h5 class="modal-title fw-bold text-<%= config.THEME_COLOR %>"><ion-icon name="share-social"></ion-icon> Thêm Tài Khoản Công Khai</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/add_password" method="POST" autocomplete="off">
          <div class="modal-body py-0">
              <input type="hidden" name="is_public_new" value="1">
              <div class="mb-3">
                  <label class="form-label fw-semibold text-secondary">Tên hệ thống</label>
                  <input type="text" name="title" class="form-control" placeholder="VD: Dự án A..." required>
              </div>
              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label class="form-label fw-semibold text-secondary">Tài khoản</label>
                      <input type="text" name="acc_username" class="form-control" autocomplete="off">
                  </div>
                  <div class="col-md-6 mb-3">
                      <label class="form-label fw-semibold text-secondary">Mật khẩu</label>
                      <input type="text" name="password" class="form-control" required autocomplete="new-password">
                  </div>
              </div>
              <div class="mb-3 secret-section">
                  <label class="form-label fw-bold text-<%= config.THEME_COLOR %>"><ion-icon name="key"></ion-icon> Mã Chia Sẻ Bí Mật</label>
                  <input type="text" name="secret_code" class="form-control" placeholder="Bắt buộc nhập mã chia sẻ" autocomplete="off" required>
                  <div class="form-text">Người khác có thể xem Mật khẩu này khi nhập mã tại trang <b>/secret</b></div>
              </div>
          </div>
          <div class="modal-footer border-top-0 pt-3 mt-2">
            <button type="button" class="btn btn-outline-secondary fw-semibold border-2" data-bs-dismiss="modal">Hủy</button>
            <button type="submit" class="btn btn-outline-<%= config.THEME_COLOR %> px-4 fw-bold shadow-sm border-2"><ion-icon name="save"></ion-icon> Lưu ngay</button>
          </div>
      </form>
    </div>
  </div>
</div>

<% passwords.forEach(p => { %>
<!-- Edit Password Modal for <%= p.id %> -->
<div class="modal fade" id="editPasswordModal-<%= p.id %>" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">
      <div class="modal-header border-bottom-0">
        <h5 class="modal-title fw-bold text-primary"><ion-icon name="create"></ion-icon> Sửa Tài Khoản</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <% let isPub = (p.secret_code && p.secret_code.trim() !== ''); %>
      <form autocomplete="off" action="/edit_password/<%= p.id %>" method="POST" <% if(!isPub) { %>onsubmit="compileUrl('<%= p.id %>')"<% } %>>
          <div class="modal-body py-0">
              <input type="hidden" name="is_public_<%= p.id %>" value="<%= isPub ? '1' : '0' %>">
              <div class="mb-3">
                  <label class="form-label fw-semibold text-secondary">Tên hệ thống</label>
                  <input type="text" name="title" class="form-control" value="<%= p.title %>" required>
              </div>
              <div class="row">
                  <div class="col-md-6 mb-3">
                      <label class="form-label fw-semibold text-secondary">Tài khoản</label>
                      <input type="text" name="acc_username" class="form-control" value="<%= p.acc_username %>" autocomplete="off">
                  </div>
                  <div class="col-md-6 mb-3">
                      <label class="form-label fw-semibold text-secondary">Mật khẩu mới</label>
                      <input type="text" name="password" class="form-control" placeholder="Bỏ trống = Không đổi" autocomplete="new-password">
                  </div>
              </div>
              
              <% if (!isPub) { %>
              <!-- INTERNAL ONLY FIELDS -->
              <div class="mb-3 url-section">
                  <label class="form-label fw-semibold text-secondary mb-1">Cấu hình Đường dẫn (URL)</label>
                  <div class="mb-3">
                      <% 
                          let hasHttp = false;
                          if (p.url) { hasHttp = p.url.includes('http://'); }
                      %>
                      <div class="btn-group btn-group-sm w-100 shadow-sm" role="group">
                          <input type="radio" class="btn-check" name="protocol_<%= p.id %>" id="proto_https_<%= p.id %>" value="https://" <%= !hasHttp ? 'checked' : '' %>>
                          <label class="btn btn-outline-success" for="proto_https_<%= p.id %>"><ion-icon name="lock-closed"></ion-icon> HTTPS (Bảo mật)</label>
                          <input type="radio" class="btn-check" name="protocol_<%= p.id %>" id="proto_http_<%= p.id %>" value="http://" <%= hasHttp ? 'checked' : '' %>>
                          <label class="btn btn-outline-info" for="proto_http_<%= p.id %>"><ion-icon name="globe"></ion-icon> HTTP (Nội bộ)</label>
                      </div>
                  </div>
                  <div id="link-container-<%= p.id %>">
                      <% 
                          if (p.url) {
                              let items = p.url.split(/[,;\n]+/).filter(u => u.trim() !== '');
                              items.forEach(item => {
                                  let rowName = '';
                                  let rowUrl = '';
                                  if (item.includes('|')) {
                                      let parts = item.split('|');
                                      let p0 = parts[0].trim();
                                      let p1 = parts.slice(1).join('|').trim();
                                      let p0IsUrl = /^https?:\/\//i.test(p0) || (p0.includes('.') && !p0.includes(' '));
                                      let p1IsUrl = /^https?:\/\//i.test(p1) || (p1.includes('.') && !p1.includes(' '));
                                      if (p0IsUrl && !p1IsUrl) { rowUrl = p0; rowName = p1; } else { rowUrl = p1; rowName = p0; }
                                  } else {
                                      rowUrl = item.trim();
                                  }
                                  rowUrl = rowUrl.replace(/^https?:\/\//i, '');
                      %>
                      <div class="input-group mb-2 link-row">
                          <input type="text" class="form-control link-name" placeholder="Tên" value="<%= rowName %>">
                          <input type="text" class="form-control link-url" placeholder="Link" value="<%= rowUrl %>">
                          <button class="btn btn-outline-danger btn-remove-link" type="button" onclick="this.parentElement.remove()"><ion-icon name="trash" class="d-flex"></ion-icon></button>
                      </div>
                      <% }); } else { %>
                      <div class="input-group mb-2 link-row">
                          <input type="text" class="form-control link-name" placeholder="Tên">
                          <input type="text" class="form-control link-url" placeholder="Link">
                          <button class="btn btn-outline-danger btn-remove-link" type="button" onclick="this.parentElement.remove()"><ion-icon name="trash" class="d-flex"></ion-icon></button>
                      </div>
                      <% } %>
                  </div>
                  <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addLinkRow('<%= p.id %>')"><ion-icon name="add" class="align-middle"></ion-icon> Thêm Link</button>
                  <input type="hidden" name="url" id="final_url_<%= p.id %>">
              </div>
              
              <div class="mb-3 notes-section">
                  <label class="form-label fw-semibold text-secondary">Ghi chú</label>
                  <textarea name="notes" class="form-control" rows="2"><%= p.notes || '' %></textarea>
              </div>
              
              <div class="mb-3 users-section">
                  <label class="form-label fw-semibold text-secondary d-block">Phân quyền cho User</label>
                  <div class="d-flex flex-wrap gap-2 border p-2 rounded-3">
                      <% allUsers.forEach(u => { %>
                          <% if (u.id !== user.id) { %>
                          <div>
                              <input type="checkbox" class="btn-check" name="allowed_users" value="<%= u.id %>" id="editUser-<%= p.id %>-<%= u.id %>" <%= (p.shared_with && p.shared_with.includes(u.username)) ? 'checked' : '' %>>
                              <label class="btn btn-outline-secondary rounded-pill btn-sm d-inline-flex align-items-center fw-normal" for="editUser-<%= p.id %>-<%= u.id %>">
                                  <ion-icon name="person-circle" class="me-1 fs-6"></ion-icon><!--email_off--><%= u.username %><!--/email_off-->
                              </label>
                          </div>
                          <% } %>
                      <% }) %>
                      <% if (allUsers.length <= 1) { %>
                          <small class="text-muted fst-italic">Chưa có user nào khác ngoài bạn.</small>
                      <% } %>
                  </div>
              </div>
              <% } else { %>
              <!-- PUBLIC ONLY FIELDS -->
              <div class="mb-3 secret-section">
                  <label class="form-label fw-bold text-<%= config.THEME_COLOR %>"><ion-icon name="key"></ion-icon> Mã Chia Sẻ Bí Mật</label>
                  <input type="text" name="secret_code" class="form-control" value="<%= p.secret_code || '' %>" placeholder="Bắt buộc nhập mã chia sẻ" autocomplete="off" required>
                  <div class="form-text">Người khác có thể xem Mật khẩu này khi nhập mã tại trang <b>/secret</b></div>
              </div>
              <% } %>

          </div>
          <div class="modal-footer border-top-0 pt-3 mt-2">
            <button type="button" class="btn btn-outline-secondary fw-semibold border-2" data-bs-dismiss="modal">Hủy</button>
            <button type="submit" class="btn btn-outline-primary px-4 fw-bold shadow-sm border-2"><ion-icon name="save"></ion-icon> Cập nhật</button>
          </div>
      </form>
    </div>
  </div>
</div>
<% }) %>

<!-- Manage Users Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-success"><ion-icon name="people"></ion-icon> Quản lý Người Dùng</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
          <div class="bg-body-tertiary p-3 rounded-4 mb-4 border shadow-sm">
              <h6 class="fw-bold mb-3"><ion-icon name="person-add"></ion-icon> Tạo tài khoản mới</h6>
              <form action="/add_user" method="POST">
                  <div class="row g-2 mb-2">
                      <div class="col-sm-6">
                          <input type="text" name="username" class="form-control form-control-sm" placeholder="Tên đăng nhập" required>
                      </div>
                      <div class="col-sm-6">
