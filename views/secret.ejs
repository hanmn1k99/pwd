<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Đăng nhập - <%= config.SITE_NAME %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: var(--bs-body-bg); transition: background-color 0.3s; }
        .login-container { max-width: 400px; margin-top: 15vh; }
        ion-icon { pointer-events: none; vertical-align: text-bottom; margin-right: 4px; font-size: 1.15em; }
        .fade-out { transition: opacity 0.5s ease, transform 0.5s ease; opacity: 0; transform: translateY(-20px); }
        
        /* Chế độ Dark Mode lấy cảm hứng từ Autobell (Bản tăng cường độ tương phản) */
        [data-bs-theme="dark"] body { background-color: #0b0f1a; color: #f8fafc; }
        [data-bs-theme="dark"] .card { background-color: #1e293b; border: 1px solid rgba(255,255,255,0.15); box-shadow: 0 10px 25px rgba(0,0,0,0.5) !important; }
        [data-bs-theme="dark"] .bg-body-tertiary { background-color: #0f1629 !important; border: 1px solid rgba(255,255,255,0.15); color: #3b82f6 !important; }
        
        [data-bs-theme="dark"] .text-primary { color: #60a5fa !important; }
        [data-bs-theme="dark"] .btn-outline-primary { color: #60a5fa; border-color: #60a5fa; border-width: 2px; }
        [data-bs-theme="dark"] .btn-outline-primary:hover { background-color: #60a5fa; color: #000; }
        
        [data-bs-theme="dark"] .text-secondary, [data-bs-theme="dark"] .text-muted { color: #94a3b8 !important; }
    </style>

    <!-- PWA & Favicon -->
    <link rel="icon" type="image/png" href="/icon.png">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0d6efd">
</head>
<body>
    <!-- Nút Theme -->
    <button class="btn btn-sm btn-outline-secondary position-fixed top-0 end-0 m-3 rounded-circle" id="themeToggle" style="width: 40px; height: 40px; z-index: 1050;">
        <ion-icon name="moon" id="themeIcon"></ion-icon>
    </button>
    
    <div class="container pb-5">
        <% if (!passwordData) { %>
        <div class="row justify-content-center align-items-center" style="min-height: 85vh;">
            <div class="col-11 col-sm-8 col-md-6 col-lg-5 col-xl-4">
                <div class="bg-body px-4 px-md-5 py-5 rounded-4 shadow-lg border border-secondary-subtle">
                    <div class="text-center mb-4">
                        <img src="/logo.png" alt="MinhHan Logo" style="height: 55px; max-width: 100%; display:block; margin: 0 auto 25px;">
                        <h4 class="fw-bold mt-3 mb-2">Tra Cứu Bí Mật</h4>
                        <p class="text-muted mb-4">Nhập mã bí mật được cấp để xem thông tin</p>
                    </div>
                    
                    <% if (error) { %>
                        <div class="alert alert-danger py-2 auto-dismiss-alert rounded-3" role="alert"><ion-icon name="warning"></ion-icon> <%= error %></div>
                    <% } %>
                    
                    <form method="POST" autocomplete="off">
                        <div class="mb-5">
                            <label class="form-label fw-semibold text-secondary mb-2">Mã truy cập bí mật</label>
                            <div class="position-relative shadow-sm rounded-3">
                                <input type="text" id="secretCodeInput" name="secret_code" class="form-control bg-body-tertiary" style="-webkit-text-security: disc; padding-right: 40px; border-color: var(--bs-border-color);" placeholder="Nhập mã bí mật..." required autofocus style="padding-right: 40px; border-color: var(--bs-border-color);">
                                <span class="position-absolute top-50 translate-middle-y text-secondary" onclick="toggleMainSecret()" style="right: 12px; cursor: pointer; z-index: 10; display: flex; transition: 0.2s;" onmouseover="this.style.color='var(--bs-primary)'" onmouseout="this.style.color=''">
                                    <ion-icon name="eye" id="mainSecretIcon" style="font-size: 1.25rem;"></ion-icon>
                                </span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-<%= config.THEME_COLOR %> w-100 fw-bold shadow-sm text-white rounded-3 mb-2"><ion-icon name="search"></ion-icon> Xem dữ liệu</button>
                    </form>
                    <div class="text-center mt-3">
                        <a href="/login" class="text-decoration-none text-muted" style="font-size: 0.9em;"><ion-icon name="arrow-back"></ion-icon> Quay lại Đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
        <% } else { %>
        
        <!-- Expanded Grid View for Passwords -->
        <div class="mt-4 mt-md-5">
            <div class="text-center mb-4 mb-md-5">
                <h3 class="fw-bold text-<%= config.THEME_COLOR %>"><ion-icon name="folder-open" class="me-2"></ion-icon>Kho Dữ Liệu Bí Mật</h3>
                <div class="alert alert-success d-inline-block py-2 px-4 rounded-pill shadow-sm mt-2 border-0">
                    <ion-icon name="checkmark-circle"></ion-icon> Xác thực thành công! Tìm thấy <b class="fs-5 mx-1"><%= passwordData.length %></b> tài khoản.
                </div>
            </div>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5 justify-content-center">
                <% passwordData.forEach((pwd, index) => { %>
                <div class="col">
                    <div class="card h-100 shadow-sm rounded-4 border border-secondary-subtle">
                        <div class="card-header bg-body-tertiary border-bottom-0 pt-3 pb-2 rounded-top-4">
                            <h5 class="fw-bold text-<%= config.THEME_COLOR %> mb-0"><ion-icon name="<%= getIconForTitle(pwd.title) %>" class="me-2"></ion-icon> <%= pwd.title %></h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <small class="text-muted d-block text-uppercase fw-bold mb-2" style="font-size: 0.70em; letter-spacing: 1px;"><ion-icon name="person"></ion-icon> Tài khoản</small>
                                <div class="d-flex align-items-center bg-body-tertiary p-2 rounded-3 border border-secondary-subtle">
                                    <span class="text-body fw-medium font-monospace flex-grow-1 ms-2" style="font-size: 0.95em;"><!--email_off--><%= pwd.acc_username %><!--/email_off--></span>
                                    <button class="btn btn-sm btn-outline-secondary border-0" onclick="copyToClipboard(`<%= pwd.acc_username.replace(/`/g, '\\`') %>`)" title="Copy"><ion-icon name="copy" class="icon-only"></ion-icon></button>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <small class="text-muted d-block text-uppercase fw-bold mb-2" style="font-size: 0.70em; letter-spacing: 1px;"><ion-icon name="lock-closed"></ion-icon> Mật khẩu</small>
                                <div class="d-flex align-items-center bg-body-tertiary p-2 rounded-3 border border-secondary-subtle">
                                    <span class="text-body font-monospace flex-grow-1 ms-2" style="font-size: 0.95em; letter-spacing: 2px;"><%= pwd.decrypted %></span>
                                    <button class="btn btn-sm btn-outline-secondary border-0" onclick="copyToClipboard('<%= pwd.decrypted %>')" title="Copy"><ion-icon name="copy" class="icon-only"></ion-icon></button>
                                </div>
                            </div>
                            
                            <% if (pwd.url) { %>
                                <div class="mb-3">
                                    <small class="text-muted d-block text-uppercase fw-bold mb-2" style="font-size: 0.70em; letter-spacing: 1px;"><ion-icon name="link"></ion-icon> Truy cập</small>
                                    <div class="d-flex flex-wrap gap-1">
                                        <% 
                                          let items = pwd.url.split(/[\,\;\n]+/).filter(u => u.trim() !== '');
                                          items.forEach(item => {
                                            let name = '';
                                            let rawUrl = '';
                                            if (item.includes('|')) {
                                                let parts = item.split('|');
                                                let p0 = parts[0].trim();
                                                let p1 = parts.slice(1).join('|').trim();
                                                let p0IsUrl = /^https?:\/\//i.test(p0) || (p0.includes('.') && !p0.includes(' '));
                                                let p1IsUrl = /^https?:\/\//i.test(p1) || (p1.includes('.') && !p1.includes(' '));
                                                if (p0IsUrl && !p1IsUrl) { rawUrl = p0; name = p1; } else { rawUrl = p1; name = p0; }
                                            } else {
                                                rawUrl = item.trim();
                                                name = rawUrl.replace(/^https?:\/\//i, '');
                                            }
                                            let fixedUrl = rawUrl;
                                            if (!fixedUrl.startsWith('http://') && !fixedUrl.startsWith('https://')) fixedUrl = 'http://' + fixedUrl;
                                        %>
                                        <a href="<%= fixedUrl %>" target="_blank" class="badge bg-body-secondary text-secondary text-decoration-none d-inline-flex align-items-center py-1 px-2 border border-secondary-subtle fw-medium rounded-pill" style="font-size: 0.85em;">
                                            <ion-icon name="link-outline" class="me-1"></ion-icon> <%= name %>
                                        </a>
                                        <% }); %>
                                    </div>
                                </div>
                            <% } %>
                            
                            <% if (pwd.notes) { %>
                            <div class="mb-0">
                                <small class="text-muted d-block text-uppercase fw-bold mb-2" style="font-size: 0.70em; letter-spacing: 1px;"><ion-icon name="document-text"></ion-icon> Ghi chú</small>
                                <textarea class="form-control bg-body-tertiary shadow-sm border-secondary-subtle" rows="2" readonly><%= pwd.notes %></textarea>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
            
            <div class="text-center mt-3">
                <a href="/clear_secret" class="btn btn-outline-secondary px-5 rounded-pill shadow-sm fw-semibold border-2"><ion-icon name="refresh"></ion-icon> Tra cứu mã khác</a>
            </div>
        </div>
        <% } %>
    </div>
    
    <!-- Toast Container -->
<!-- Toast Container -->
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1100;"></div>
    
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <script>
        function toggleMainSecret() {
            const input = document.getElementById('secretCodeInput');
            const icon = document.getElementById('mainSecretIcon');
            if (input.style.webkitTextSecurity === 'none' || !input.style.webkitTextSecurity) {
                input.style.webkitTextSecurity = 'disc';
                icon.name = 'eye';
            } else {
                input.style.webkitTextSecurity = 'none';
                icon.name = 'eye-off';
            }
        }
        
        function toggleSecretPassword(index) {
            const input = document.getElementById('pw-secret-' + index);
            const icon = document.getElementById('icon-secret-' + index);
            if (input.style.webkitTextSecurity === 'none' || !input.style.webkitTextSecurity) {
                input.style.webkitTextSecurity = 'disc';
                icon.name = 'eye';
            } else {
                input.style.webkitTextSecurity = 'none';
                icon.name = 'eye-off';
            }
        }
        
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                const toastContainer = document.querySelector('.position-fixed.top-0.end-0');
                if (toastContainer) {
                    const alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-success shadow-sm auto-dismiss-alert';
                    alertDiv.innerHTML = '<ion-icon name="clipboard"></ion-icon> Đã copy vào bộ nhớ tạm!';
                    alertDiv.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                    toastContainer.appendChild(alertDiv);
                    
                    setTimeout(() => {
                        alertDiv.classList.add('fade-out');
                        setTimeout(() => alertDiv.remove(), 500);
                    }, 2000);
                }
            });
        }
        // Tự động ẩn thông báo lỗi sau 3 giây
        setTimeout(() => {
            document.querySelectorAll('.auto-dismiss-alert').forEach(el => {
                el.style.transition = 'opacity 0.5s ease';
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 500);
            });
        }, 3000);

        const htmlEl = document.documentElement;
        const themeBtn = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const savedTheme = localStorage.getItem('theme') || 'light';
        htmlEl.setAttribute('data-bs-theme', savedTheme);
        themeIcon.setAttribute('name', savedTheme === 'dark' ? 'sunny' : 'moon');
        if(savedTheme === 'dark') themeIcon.style.color = '#ffc107';

        themeBtn.addEventListener('click', () => {
            const current = htmlEl.getAttribute('data-bs-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            htmlEl.setAttribute('data-bs-theme', next);
            localStorage.setItem('theme', next);
            themeIcon.setAttribute('name', next === 'dark' ? 'sunny' : 'moon');
            themeIcon.style.color = next === 'dark' ? '#ffc107' : '';
        });
    </script>

    <!-- Đăng ký Service Worker cho PWA -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js');
        });
      }
    </script>
</body>
</html>