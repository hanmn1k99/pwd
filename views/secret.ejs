<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Đăng nhập - <%= config.SITE_NAME %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: var(--bs-body-bg); transition: background-color 0.3s; }
        .login-container { max-width: 400px; margin-top: 15vh; }
        ion-icon { pointer-events: none; vertical-align: text-bottom; margin-right: 4px; font-size: 1.15em; }
        .fade-out { transition: opacity 0.5s ease, transform 0.5s ease; opacity: 0; transform: translateY(-20px); }
        
        /* Chế độ Dark Mode lấy cảm hứng từ Autobell (Bản tăng cường độ tương phản) */
        [data-bs-theme="dark"] body { background-color: #0b0f1a; color: #f8fafc; }
        [data-bs-theme="dark"] .card { background-color: #1e293b; border: 1px solid rgba(255,255,255,0.15); box-shadow: 0 10px 25px rgba(0,0,0,0.5) !important; }
        [data-bs-theme="dark"] .bg-body-tertiary { background-color: #0f1629 !important; border: 1px solid rgba(255,255,255,0.15); color: #3b82f6 !important; }
        
        [data-bs-theme="dark"] .text-primary { color: #60a5fa !important; }
        [data-bs-theme="dark"] .btn-outline-primary { color: #60a5fa; border-color: #60a5fa; border-width: 2px; }
        [data-bs-theme="dark"] .btn-outline-primary:hover { background-color: #60a5fa; color: #000; }
        
        [data-bs-theme="dark"] .text-secondary, [data-bs-theme="dark"] .text-muted { color: #94a3b8 !important; }
    </style>

    <!-- PWA & Favicon -->
    <link rel="icon" type="image/png" href="/icon.png">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0d6efd">
</head>
<body>
    <button id="themeToggle" class="btn btn-outline-secondary position-absolute top-0 end-0 m-3 rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width:45px; height:45px;">
        <ion-icon id="themeIcon" name="moon" class="theme-btn"></ion-icon>
    </button>

    <div class="container login-container" style="margin-top: 10vh;">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-<%= config.THEME_COLOR %>">
                        <img src="/logo.png" alt="Logo" style="width: 250px; max-width: 100%; height: auto; display:block; margin: 0 auto 10px;">
                    </h3>
                    <p class="text-muted"><ion-icon name="key-outline"></ion-icon> Cổng Tra Cứu Bảo Mật</p>
                </div>
                
                <% if (error) { %>
                    <div class="alert alert-danger py-2 auto-dismiss-alert" role="alert"><ion-icon name="warning"></ion-icon> <%= error %></div>
                <% } %>
                
                <% if (!passwordData) { %>
                <form method="POST">
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary">Mã truy cập bí mật</label>
                        <input type="text" name="secret_code" class="form-control form-control-lg bg-body-tertiary" placeholder="Nhập mã bí mật..." required autofocus>
                    </div>
                    <button type="submit" class="btn btn-outline-<%= config.THEME_COLOR %> btn-lg w-100 fw-bold shadow-sm"><ion-icon name="search"></ion-icon> Xem dữ liệu</button>
                </form>
                <% } else { %>
                    <div class="alert alert-success py-2 mb-4" role="alert"><ion-icon name="checkmark-circle"></ion-icon> Xác thực thành công!</div>
                    
                    <h5 class="fw-bold text-primary mb-3"><%= passwordData.title %></h5>
                    <div class="mb-3">
                        <label class="form-label text-secondary fw-semibold mb-1">Tài khoản</label>
                        <div class="input-group">
                            <input type="text" class="form-control bg-body-tertiary" value="<%= passwordData.acc_username %>" readonly>
                            <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('<%= passwordData.acc_username %>')"><ion-icon name="copy" class="icon-only"></ion-icon></button>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label text-secondary fw-semibold mb-1">Mật khẩu</label>
                        <div class="input-group">
                            <input type="text" class="form-control bg-body-tertiary font-monospace" value="<%= passwordData.decrypted %>" readonly>
                            <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('<%= passwordData.decrypted %>')"><ion-icon name="copy" class="icon-only"></ion-icon></button>
                        </div>
                    </div>
                    
                    <% if (passwordData.url) { %>
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold mb-1">Truy cập</label>
                            <div class="d-flex flex-wrap gap-1">
                                <% 
                                  let items = passwordData.url.split(/[,;\n]+/).filter(u => u.trim() !== '');
                                  items.forEach(item => {
                                    let name = '';
                                    let rawUrl = '';
                                    if (item.includes('|')) {
                                        let parts = item.split('|');
                                        let p0 = parts[0].trim();
                                        let p1 = parts.slice(1).join('|').trim();
                                        let p0IsUrl = /^https?:\/\//i.test(p0) || (p0.includes('.') && !p0.includes(' '));
                                        let p1IsUrl = /^https?:\/\//i.test(p1) || (p1.includes('.') && !p1.includes(' '));
                                        if (p0IsUrl && !p1IsUrl) { rawUrl = p0; name = p1; } else { rawUrl = p1; name = p0; }
                                    } else {
                                        rawUrl = item.trim();
                                        name = rawUrl.replace(/^https?:\/\//i, '');
                                    }
                                    let fixedUrl = rawUrl;
                                    if (!fixedUrl.startsWith('http://') && !fixedUrl.startsWith('https://')) fixedUrl = 'http://' + fixedUrl;
                                %>
                                <a href="<%= fixedUrl %>" target="_blank" class="badge bg-body-secondary text-secondary text-decoration-none d-inline-flex align-items-center py-1 px-2 border border-secondary-subtle fw-medium rounded-pill" style="font-size: 0.85em;">
                                    <ion-icon name="link-outline" class="me-1"></ion-icon> <%= name %>
                                </a>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>
                    
                    <% if (passwordData.notes) { %>
                    <div class="mb-3">
                        <label class="form-label text-secondary fw-semibold mb-1">Ghi chú</label>
                        <textarea class="form-control bg-body-tertiary" rows="2" readonly><%= passwordData.notes %></textarea>
                    </div>
                    <% } %>
                    
                    <a href="/secret" class="btn btn-outline-secondary w-100 mt-2"><ion-icon name="refresh"></ion-icon> Tra cứu mã khác</a>
                <% } %>
            </div>
        </div>
    </div>
    
    <!-- Toast Container -->
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1100;"></div>
    
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                const toastContainer = document.querySelector('.position-fixed.top-0.end-0');
                if (toastContainer) {
                    const alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-success shadow-sm auto-dismiss-alert';
                    alertDiv.innerHTML = '<ion-icon name="clipboard"></ion-icon> Đã copy vào bộ nhớ tạm!';
                    alertDiv.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                    toastContainer.appendChild(alertDiv);
                    
                    setTimeout(() => {
                        alertDiv.classList.add('fade-out');
                        setTimeout(() => alertDiv.remove(), 500);
                    }, 2000);
                }
            });
        }
        // Tự động ẩn thông báo lỗi sau 3 giây
        setTimeout(() => {
            document.querySelectorAll('.auto-dismiss-alert').forEach(el => {
                el.style.transition = 'opacity 0.5s ease';
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 500);
            });
        }, 3000);

        const htmlEl = document.documentElement;
        const themeBtn = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const savedTheme = localStorage.getItem('theme') || 'light';
        htmlEl.setAttribute('data-bs-theme', savedTheme);
        themeIcon.setAttribute('name', savedTheme === 'dark' ? 'sunny' : 'moon');
        if(savedTheme === 'dark') themeIcon.style.color = '#ffc107';

        themeBtn.addEventListener('click', () => {
            const current = htmlEl.getAttribute('data-bs-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            htmlEl.setAttribute('data-bs-theme', next);
            localStorage.setItem('theme', next);
            themeIcon.setAttribute('name', next === 'dark' ? 'sunny' : 'moon');
            themeIcon.style.color = next === 'dark' ? '#ffc107' : '';
        });
    </script>

    <!-- Đăng ký Service Worker cho PWA -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js');
        });
      }
    </script>
</body>
</html>
